#!/bin/sh
# =============================================================================
# FILE: gradlew
# =============================================================================
# OBJECTIVE:
#   Unix shell script that downloads and runs the Gradle Wrapper.
#   Developers and CI systems run ./gradlew <task> instead of relying on a
#   system-installed Gradle, ensuring every build uses the pinned version.
#   Run:  ./gradlew assembleDebug    to build the debug APK
#         ./gradlew assembleRelease  to build the release APK
#         ./gradlew installDebug     to install on a connected device
# =============================================================================

##############################################################################
# Gradle start up script for UN*X
##############################################################################
APP_NAME="Gradle"
APP_BASE_NAME=`basename "$0"`
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD="java"
fi

# Get the fully qualified path of this script
SCRIPT_DIR=`dirname "$0"`
APP_HOME=`cd "$SCRIPT_DIR" && pwd`

CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"

exec "$JAVACMD" $DEFAULT_JVM_OPTS \
  -classpath "$CLASSPATH" \
  org.gradle.wrapper.GradleWrapperMain "$@"
