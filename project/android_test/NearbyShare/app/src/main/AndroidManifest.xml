<?xml version="1.0" encoding="utf-8"?>
<!--
=============================================================================
FILE: AndroidManifest.xml
=============================================================================
INDEX OF CONTENTS:
  1. Required permissions (Bluetooth, Wi-Fi, Location, Nearby Devices)
  2. Application node with Hilt application class
  3. Activity declarations (MainActivity, ShareActivity, ReceiveActivity)
  4. Service declaration (NearbyShareService)
  5. File provider for secure URI sharing

OBJECTIVE:
  Declares all Android system-level requirements for NearbyShare.
  Permissions are carefully chosen per API level:
    - ACCESS_FINE_LOCATION needed for Wi-Fi/BLE discovery on API < 31
    - BLUETOOTH_SCAN / BLUETOOTH_CONNECT / BLUETOOTH_ADVERTISE for API >= 31
    - NEARBY_WIFI_DEVICES for Wi-Fi peer discovery on API >= 33
  The app is marked hardware-feature optional so it installs on devices
  without specific hardware (graceful degradation).
=============================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ================================================================== -->
    <!-- PERMISSIONS                                                          -->
    <!-- ================================================================== -->

    <!-- Internet access for socket-based file transfer -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Wi-Fi Direct / hotspot for peer-to-peer transfer -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Wi-Fi peer discovery (API 33+) -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- Location needed for BLE/Wi-Fi scanning on API < 31 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Classic Bluetooth (API < 31) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Modern Bluetooth (API >= 31) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:targetApi="s" />

    <!-- Read/write storage for sharing files -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- Granular media permissions (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"
        tools:targetApi="tiramisu" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"
        tools:targetApi="tiramisu" />

    <!-- Foreground service for ongoing transfers -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="upside_down_cake" />

    <!-- Vibration for transfer complete feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Wake lock to keep transfer alive when screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ================================================================== -->
    <!-- OPTIONAL HARDWARE FEATURES (allows install on all devices)          -->
    <!-- ================================================================== -->
    <uses-feature android:name="android.hardware.bluetooth_le"
        android:required="false" />
    <uses-feature android:name="android.hardware.wifi.direct"
        android:required="false" />
    <uses-feature android:name="android.hardware.location"
        android:required="false" />

    <!-- ================================================================== -->
    <!-- APPLICATION                                                          -->
    <!-- ================================================================== -->
    <application
        android:name=".NearbyShareApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NearbyShare"
        tools:targetApi="31">

        <!-- Main launcher activity -->
        <activity
            android:name=".ui.activities.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity shown when user initiates a share from another app -->
        <activity
            android:name=".ui.activities.ShareActivity"
            android:exported="true"
            android:theme="@style/Theme.NearbyShare.BottomSheet"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Activity to show incoming transfer requests to the receiver -->
        <activity
            android:name=".ui.activities.ReceiveActivity"
            android:exported="false"
            android:theme="@style/Theme.NearbyShare.BottomSheet"
            android:showOnLockScreen="true"
            android:turnScreenOn="true" />

        <!-- Settings activity -->
        <activity
            android:name=".ui.activities.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.activities.MainActivity" />

        <!-- Foreground service handling BLE advertising + Wi-Fi transfer -->
        <service
            android:name=".service.NearbyShareService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- FileProvider for sharing file URIs securely between apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
