<?xml version="1.0" encoding="utf-8"?>
<!-- bottomsheet_transfer.xml — Send from home screen (choose files) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="32dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_drag_handle"/>

    <!-- Remote device avatar -->
    <androidx.cardview.widget.CardView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="32dp"
        app:cardBackgroundColor="@color/avatar_blue"
        app:cardElevation="2dp">

        <TextView
            android:id="@+id/tv_device_initials_transfer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="PX"/>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_send_to_device"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
        tools:text="Send to Pixel 8 Pro"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_choose_files"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp"
        android:text="@string/choose_files"
        app:cornerRadius="26dp"
        app:icon="@drawable/ic_file_generic"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_transfer_cancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="@string/cancel"/>
</LinearLayout>
