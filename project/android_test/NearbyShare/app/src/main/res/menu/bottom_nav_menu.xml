<?xml version="1.0" encoding="utf-8"?>
<!--
=============================================================================
FILE: res/menu/bottom_nav_menu.xml
=============================================================================
OBJECTIVE:
  Defines the three tabs for the BottomNavigationView in MainActivity.
  Each item id must match the destination id in nav_graph.xml so that
  setupWithNavController() can automatically keep them in sync.
=============================================================================
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Home tab — device discovery screen -->
    <item
        android:id="@+id/homeFragment"
        android:icon="@drawable/ic_home"
        android:title="@string/nav_home"/>

    <!-- Transfer tab — active/recent transfer progress -->
    <item
        android:id="@+id/transferFragment"
        android:icon="@drawable/ic_share"
        android:title="@string/nav_transfer"/>

</menu>
