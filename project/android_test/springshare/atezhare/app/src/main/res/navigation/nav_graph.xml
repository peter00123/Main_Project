<?xml version="1.0" encoding="utf-8"?>
<!--
    navigation/nav_graph.xml
    NavController navigation graph for all fragments inside MainActivity.
    Start destination: homeFragment
    Bottom nav IDs must match fragment IDs here for setupWithNavController to auto-navigate.
    Used by: res/layout/activity_main.xml (NavHostFragment), ui/home/MainActivity
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Home / Landing Page — see ui/home/HomeFragment -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.atezhare.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_directory"
            app:destination="@id/directoryFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_home_to_receive"
            app:destination="@id/receiveFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- Directory / File Selection — see ui/directory/DirectoryFragment -->
    <fragment
        android:id="@+id/directoryFragment"
        android:name="com.atezhare.ui.directory.DirectoryFragment"
        android:label="Directory"
        tools:layout="@layout/fragment_directory" />

    <!-- Receive — see ui/receive/ReceiveFragment -->
    <fragment
        android:id="@+id/receiveFragment"
        android:name="com.atezhare.ui.receive.ReceiveFragment"
        android:label="Receive"
        tools:layout="@layout/fragment_receive" />

    <!-- Profile — see ui/profile/ProfileFragment -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.atezhare.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <!-- Settings — see ui/profile/SettingsFragment, opened from drawer menu -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.atezhare.ui.profile.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
