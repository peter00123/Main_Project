<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background">#0B1311</color>
    <color name="divider">#2D4A43</color>
    <color name="on_background">#FFFFFF</color>
    <color name="primary">#00704A</color>
    <color name="primary_dark">#1E3932</color>
    <color name="primary_light">#D4E9E2</color>
    <color name="secondary">#006241</color>
    <color name="secondary_dark">#1E3932</color>
    <color name="surface">#1E3932</color>
    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#D4E9E2</color>
    <style name="Theme.Atezhare" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_background</item>

        
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>
    <style name="Theme.Atezhare.NoActionBar" parent="Theme.Atezhare">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Theme.Atezhare.Splash" parent="Theme.Atezhare">
        <item name="android:statusBarColor">@color/background</item>
    </style>
</resources>