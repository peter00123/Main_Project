<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_send.xml
    Standalone sender screen — no toolbar or bottom nav bar.
    Layout:
      - Close (X) button at top-left
      - CameraX PreviewView (center) for scanning receiver's QR
      - Scan frame overlay on the camera
      - "Or share this code:" label
      - Large 6-digit code display (generated by backend)
      - "Share Code" subtitle
    Used by: ui/send/SendActivity
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

    <!-- CameraX preview — full screen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Semi-transparent overlay for scan area framing -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/qr_scan_overlay" />

    <!-- Close button top-left -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_close"
        android:background="@drawable/circle_button_bg"
        android:contentDescription="Close"
        android:tint="@android:color/white" />

    <!-- Camera permission fallback message -->
    <TextView
        android:id="@+id/tv_no_camera_permission"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Camera permission required\nto scan QR codes"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Bottom info card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Scanning instruction -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Point camera at receiver's QR code"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="16dp" />

        <!-- Divider label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Or share this code with receiver:"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <!-- 6-digit share code — populated by SendViewModel -->
        <TextView
            android:id="@+id/tv_share_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="------"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:letterSpacing="0.3"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share this code with the receiver"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <!-- Progress indicator -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
