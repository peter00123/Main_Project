<?xml version="1.0" encoding="utf-8"?>
<!-- 
    font/app_font_bold.xml
    Font family definition. Replace with an actual .ttf file (e.g. Poppins-Bold.ttf)
    downloaded into the font/ folder. Reference: @font/app_font_bold in layouts.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/app_font_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/app_font_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
