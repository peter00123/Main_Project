<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml
    Declares all activities, permissions, and app metadata for Atezhare.
    Permissions: INTERNET (Retrofit calls), CAMERA (QR scanning in SendFragment),
    READ_EXTERNAL_STORAGE / READ_MEDIA_* (file picking in DirectoryFragment)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permission — required for all Retrofit calls in network/ApiService -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground Service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera permission — required for QR scanning in ui/send/SendFragment -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Storage permissions — required for file picking in ui/directory/DirectoryFragment -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Atezhare"
        android:usesCleartextTraffic="true">

        <!-- SplashActivity — entry point, checks session via utils/SessionManager -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Atezhare.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LoginActivity — shown if user is not logged in -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <!-- SignUpActivity — register new users via Supabase Auth -->
        <activity
            android:name=".ui.auth.SignUpActivity"
            android:exported="false" />

        <!-- MainActivity — hosts NavController, BottomNav -->
        <activity
            android:name=".ui.home.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Atezhare.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="atezhare" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.profile.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Atezhare.NoActionBar" />

        <activity
            android:name=".ui.profile.AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.Atezhare.NoActionBar" />

        <activity
            android:name=".ui.profile.AboutDescriptionActivity"
            android:exported="false"
            android:theme="@style/Theme.Atezhare.NoActionBar" />

        <activity
            android:name=".ui.profile.AboutVersionActivity"
            android:exported="false"
            android:theme="@style/Theme.Atezhare.NoActionBar" />

        <activity
            android:name=".ui.profile.TestingActivity"
            android:exported="false"
            android:theme="@style/Theme.Atezhare.NoActionBar" />

        <!-- SendActivity — standalone QR scanner screen (no toolbar/bottom nav) -->
        <activity
            android:name=".ui.send.SendActivity"
            android:exported="false"
            android:theme="@style/Theme.Atezhare.NoActionBar" />

        <activity
            android:name=".ui.shareddata.ImageViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.Atezhare.NoActionBar" />

        <service
            android:name=".service.TransferService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
